[server]
server1 ansible_host={{ server_info.instances[0].public_ip_address }} private_ip={{ server_info.instances[0].private_ip_address }}

[workers]
{% for instance in worker_info.instances | sort(attribute='launch_time') %}
worker{{ loop.index }} ansible_host={{ instance.public_ip_address }} private_ip={{ instance.private_ip_address }}
{% endfor %}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file={{ ssh_key_file }}
